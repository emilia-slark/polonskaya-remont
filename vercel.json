{
	"rewrites": [{ "source": "/(.*)", "destination": "/" }],
	"headers": [
		{
			"source": "/index.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, max-age=0"
				}
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, immutable"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000"
				}
			]
		}
	]
}
